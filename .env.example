# ==============================================================================
# NFT/DeFi Agent — environment configuration
# Copy this file to `.env` and fill in what you have. Everything is optional
# except DRY_RUN's default — the agent runs in mock mode with nothing set.
# ==============================================================================

# ------------------------------------------------------------------------------
# Safety guard — DO NOT SET TO false IN THIS VERSION.
# Live transaction signing/broadcasting is not implemented yet (see README).
# When true (default), the order layer only computes and logs what it would
# submit — no wallet is touched, nothing is signed or sent.
# ------------------------------------------------------------------------------
DRY_RUN=true

# ------------------------------------------------------------------------------
# OpenSea API v2 (https://docs.opensea.io/reference)
# NFT marketplace data/orders — collections, listings, offers, traits, events.
# Two ways to get a key, see README "OpenSea API v2" section for details:
#   - Instant agent key (fastest): POST https://api.opensea.io/api/v2/auth/keys
#     with no auth — 30-day key, 60 req/min read. Good for trying this out.
#   - Permanent key: opensea.io -> account -> Settings -> Developer.
# Without a key, the client falls back to MOCK DATA automatically so you can
# still run and explore the whole agent.
# ------------------------------------------------------------------------------
OPENSEA_API_KEY=
OPENSEA_BASE_URL=https://api.opensea.io/api/v2

# ------------------------------------------------------------------------------
# Chain / wallet (READ-ONLY in this version — used to label output and to
# eventually build unsigned tx params, never to sign or send anything)
# ------------------------------------------------------------------------------
CHAIN_ID=1
CHAIN_NAME=ethereum
RPC_URL=
# Public wallet address only. NEVER put a private key in this file or anywhere
# in this project. The dry-run order builder never needs one.
WALLET_ADDRESS=

# ------------------------------------------------------------------------------
# Discord notifications (optional). Create a webhook: Server Settings ->
# Integrations -> Webhooks -> New Webhook -> copy URL.
# Leave blank to disable; the agent logs to console instead.
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Discord BOT (optional, separate from the webhook above). Gives you the
# emoji-reaction bid-lead workflow: the bot posts bid leads with ✅/❌/👀
# reactions, and only DISCORD_AUTHORIZED_USER_ID's reactions are honored.
# Leave DISCORD_BOT_TOKEN blank to disable — the agent logs
# "Discord bot: token missing, bot disabled" and runs without it.
# See README "Discord bot" section for how to create the bot app, get a
# token, and invite it with the right permissions.
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Your Discord user ID (enable Developer Mode in Discord, right-click your
# name, "Copy User ID"). Only this user's reactions are ever actioned.
DISCORD_AUTHORIZED_USER_ID=
# Channel IDs (right-click a channel -> Copy Channel ID). Create these
# channels in your server first; leave any blank to skip that channel.
DISCORD_BID_LEADS_CHANNEL_ID=
DISCORD_NEW_LISTINGS_CHANNEL_ID=
DISCORD_TREND_ALERTS_CHANNEL_ID=
DISCORD_ORDER_LOG_CHANNEL_ID=
DISCORD_AUDIT_LOG_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
# #watchlist-sales — recent sales for allowlisted collections (bot-only feed).
# Created automatically by `npm run setup-server` if missing; that script
# also writes the created channel's ID here.
DISCORD_SALES_CHANNEL_ID=
# Optional: pin slash-command registration to one guild ID (right-click your
# server icon -> Copy Server ID). Leave blank to register commands in every
# guild the bot is currently in — simplest default, no config needed.
DISCORD_GUILD_ID=

# ------------------------------------------------------------------------------
# Email notifications via SMTP (optional). Example values for Gmail with an
# app password. Leave blank to disable; the agent logs to console instead.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# ------------------------------------------------------------------------------
# Web dashboard
# ------------------------------------------------------------------------------
# Port the local dashboard server listens on (npm run dashboard).
DASHBOARD_PORT=3000

# ------------------------------------------------------------------------------
# Monitor settings
# ------------------------------------------------------------------------------
# How often (seconds) bid-lead generation + new-listing checks poll
# allowlisted (watchlist.json) collections. Hourly by default — do not set
# this low; it is not a "how often to flood Discord" knob, just data
# freshness. The trend/floor-move digest below runs on its own schedule,
# NOT this interval.
POLL_INTERVAL_SECONDS=3600
# Comma-separated NFT contract addresses (EVM) to watch on the LOCAL
# DASHBOARD ONLY (npm run dashboard) — this list is intentionally separate
# from watchlist.json and is never posted to Discord in any form.
WATCHED_COLLECTIONS=0x5af0d9827e0c53e4799bb226655a1de152a425a,0xbc4ca0eda7647a8ab7c2061c2e118a18a936f13
# Fire an alert when floor price moves by at least this fraction (0.05 = 5%).
# Applies to the twice-daily trend digest (TREND_ALERT_TIMES), comparing
# against the floor at the previous scheduled check.
FLOOR_MOVE_THRESHOLD=0.05
# Fire an alert on new listings priced at or below this amount (in native
# currency, e.g. ETH). Applies both to the dashboard's WATCHED_COLLECTIONS
# view and to the Discord bot's #new-listings notices (allowlisted
# collections only).
NEW_LISTING_MAX_PRICE=0.5
# Comma-separated 24h local times the Discord bot's trend/floor-move digest
# runs at, for allowlisted (watchlist.json) collections only. Default: twice
# daily. This is NOT affected by POLL_INTERVAL_SECONDS.
TREND_ALERT_TIMES=08:00,20:00
# A specific token/trait offer must beat the top collection-wide offer by at
# least this many percent to be flagged as an "above-market" highlighted bid
# lead in #bid-leads. Raise this to cut noise, lower it to catch more.
OFFER_ABOVE_COLLECTION_THRESHOLD_PERCENT=10
# On a brand-new collection's very first poll (nothing persisted yet in
# .watchlist-seen-state.json), sales older than this many minutes are
# silently baselined (never posted) instead of dumped as a backfill burst —
# only sales within this window still post. Existing/previously-polled
# collections are unaffected (their persisted baseline is used instead).
SALES_LOOKBACK_MINUTES=30
# Shows a "(~$X)" USD estimate alongside every ETH-denominated price, using
# a live ETH/USD rate (OpenSea's payment_token endpoint, CoinGecko fallback,
# cached 10 min). Set to false to show ETH only.
SHOW_USD=true
# Budget for OpenSeaClient's request scheduler (src/opensea/requestScheduler.ts)
# — every OpenSea API call is queued and paced against this, sharing one
# budget across polling, slash commands, and autocomplete. Default 50/min,
# safely under the free-tier agent key's ~60/min cap. Lower it if you're
# still seeing 429s in the logs; raise it if you have a higher-limit key.
OPENSEA_REQUESTS_PER_MINUTE=50

# ------------------------------------------------------------------------------
# Bid-lead allowlist watchlist (Discord bot)
# ------------------------------------------------------------------------------
# Path (relative to the project root) to the allowlist-only watchlist config
# that drives the bid-lead pipeline. See watchlist.json for examples and the
# README "Watchlist filters" section for the full filter reference. Nothing
# outside this file's enabled entries is ever evaluated for bid leads.
WATCHLIST_CONFIG_PATH=watchlist.json
