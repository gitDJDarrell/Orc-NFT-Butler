# --- Secrets / environment ---
.env
.env.local
.env.*.local
.env.backup
*.pem
*.key
# The committed template stays tracked:
!.env.example

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Runtime state / locks / pids ---
# Glob rather than an explicit list so a newly-added store (watched items,
# whales, floor history, ...) is ignored by default instead of being
# accidentally committed the first time it's written. NOTE: watchlist.json
# itself is CONFIG, not state, and is deliberately tracked — the leading
# dot is what separates the two.
.watchlist-*.json
.bot.lock
.bot.pid
*.pid

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
